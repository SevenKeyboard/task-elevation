<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>3.0.0</Version>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PlatformTarget>x64</PlatformTarget>
    <TaskElevationBuildNative Condition="'$(TaskElevationBuildNative)' == ''">false</TaskElevationBuildNative>
    <TaskElevationNativePath>native/win-x64/TaskElevation.Native.dll</TaskElevationNativePath>
    <TaskElevationNativePath Condition="'$(TaskElevationBuildNative)' == 'true'">native/bin/$(Configuration)/TaskElevation.Native.dll</TaskElevationNativePath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(TaskElevationNativePath)" />
    <!-- Switching between prebuilt and source-built DLLs must also replace a newer output. -->
    <None Include="$(TaskElevationNativePath)" Link="TaskElevation.Native.dll"
          CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent" />
  </ItemGroup>
  <Target Name="PrepareTaskElevationNative" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'"
           Text="TaskElevation currently supports win-x64 only." />
    <Exec Condition="'$(TaskElevationBuildNative)' == 'true'"
          Command="&quot;$(MSBuildProjectDirectory)/native/build.cmd&quot; $(Configuration)" />
    <Error Condition="!Exists('$(TaskElevationNativePath)')"
           Text="TaskElevation native DLL is missing. Restore the included native/win-x64 DLL or build with -p:TaskElevationBuildNative=true." />
  </Target>
</Project>
